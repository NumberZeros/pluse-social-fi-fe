{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/generate-og-images.mjs && tsx scripts/generate-guide-md.ts && node scripts/generate-llms-full.mjs && pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/((?!api/|llms\\.txt|llms-full\\.txt|.*\\.md$|robots\\.txt|sitemap-static\\.xml|og-image).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og-image(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "env": {
    "VITE_SITE_URL": "https://pulsesol.xyz",
    "SITE_URL": "https://pulsesol.xyz"
  },
  "crons": [
    {
      "path": "/api/sitemap.xml",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/og/post/[postId].ts": {
      "maxDuration": 60
    },
    "api/og/profile/[username].ts": {
      "maxDuration": 60
    },
    "api/sitemap.xml.ts": {
      "maxDuration": 60
    }
  }
}
