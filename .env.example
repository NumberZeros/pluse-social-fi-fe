# Observability — set in Vercel Dashboard (Production + Preview)
VITE_POSTHOG_KEY=phc_<your_project_key>
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Sentry project DSN (Vite exposes only VITE_* to the client bundle)
VITE_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>

# Vercel environment split (configure in Dashboard, not vercel.json):
# Production: VITE_SOLANA_NETWORK=mainnet, mainnet RPC (e.g. Helius), mainnet PROGRAM_ID
# Preview:   VITE_SOLANA_NETWORK=devnet, devnet RPC, devnet PROGRAM_ID
